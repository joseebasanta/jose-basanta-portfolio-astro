---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import collective2077Cover from '@/assets/collective-2077-cover.png';
import collective2077BrandGraphics from '@/assets/collective-2077/01-brand-graphics.png';
import collective2077Editorial from '@/assets/collective-2077/02-editorial-illustrations.png';
import collective2077Roadmaps from '@/assets/collective-2077/03-alpha-roadmaps.png';
import collective2077BridgeGraphics from '@/assets/collective-2077/04-bridge-infographics.png';
import collective2077EthereumBanners from '@/assets/collective-2077/05-ethereum-banners.png';
import championsArtwork from '@/assets/community-champions.png';
import ethSalvadorArtwork from '@/assets/eth-salvador.png';
import illustrationsCover from '@/assets/illustrations-cover.png';
import invisibleGardenArtwork from '@/assets/invisible-garden.png';
import kamigotchiIntroduction from '@/assets/kamigotchi/01-introduction.png';
import kamigotchiOnboarding from '@/assets/kamigotchi/02-onboarding.png';
import kamigotchiItems from '@/assets/kamigotchi/03-items-of-the-week.png';
import kamigotchiEvents from '@/assets/kamigotchi/04-community-events.png';
import kamigotchiZones from '@/assets/kamigotchi/05-new-zones.png';
import kamigotchiZoneVariants from '@/assets/kamigotchi/06-zone-variants.png';
import kamigotchiStickers from '@/assets/kamigotchi/07-stickers.png';
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@phosphor-icons/web/regular';
import '@/styles/portfolio.css';

const contactEmail = 'joseebasanta@gmail.com';
const kamigotchiDescription =
  'Graphic design and motion assets created for Kamigotchi, an on-chain idle MMORPG.';
const ethSalvadorDescription =
  'Conceptualized and executed the event brand identity for ETH Salvador 2024.';
const invisibleGardenDescription =
  'Visual identity development, event branding, web design, on-site production materials, and video editing created for the Invisible Garden program.';
const illustrationDescription = 'A selection of my illustrations.';
const collective2077Description =
  'Created branding assets, editorial graphics, and marketing visuals for a Web3 research group.';

const [profilePhoto] = Object.values(
  import.meta.glob<ImageMetadata>('/src/assets/jose-basanta-profile.{jpg,jpeg,png,webp}', {
    eager: true,
    import: 'default',
  }),
);

// Webflow is from Simple Icons. The remaining SVGs are from SVG Logos.
const toolLogos = {
  'Adobe After Effects': 'adobe-after-effects.svg',
  'Adobe Illustrator': 'adobe-illustrator.svg',
  'Adobe Photoshop': 'adobe-photoshop.svg',
  Figma: 'figma.svg',
  Midjourney: 'midjourney.svg',
  Procreate: 'procreate.png',
  Webflow: 'webflow.svg',
} as const;

type GalleryView = 'work' | 'visual-craft';
type Artwork = { image: ImageMetadata; alt: string };
type Project = {
  id: string;
  views: GalleryView[];
  shape: string;
  title: string;
  kind: string;
  summary: string;
  detail: string;
  overview?: string;
  discipline: string;
  tools?: (keyof typeof toolLogos)[];
  artwork?: Artwork[];
};

const projects: Project[] = [
  {
    id: 'nimbus',
    views: ['work'],
    shape: 'tall',
    title: 'Nimbus',
    kind: 'Concept',
    summary: 'A calmer way to see your money at a glance.',
    detail:
      'An exploration of a calmer way to see your money. A clear overview, thoughtful hierarchy, and a little breathing room turn everyday finances into something more approachable.',
    discipline: 'Product design · Interface design',
  },
  {
    id: 'elsewhere',
    views: ['work'],
    shape: 'wide',
    title: 'Elsewhere',
    kind: 'Concept',
    summary: 'A travel editorial for taking the scenic route.',
    detail:
      'A travel editorial concept for taking the scenic route. Warm photography and expressive typography make room for places, stories, and the joy of discovering somewhere new.',
    discipline: 'Web design · Art direction',
  },
  {
    id: 'variable-type',
    views: ['work'],
    shape: 'square',
    title: 'Variable Type',
    kind: 'Experiment',
    summary: 'An interactive study in how type changes character.',
    detail:
      'A small experiment in the expressive side of typography. Move the slider below and see how a single letterform changes character.',
    discipline: 'Typography · Interaction',
  },
  {
    id: 'field',
    views: ['work'],
    shape: 'wide',
    title: 'Field',
    kind: 'Concept',
    summary: 'A quieter workspace for planning one day at a time.',
    detail:
      'A productivity concept built around a quieter day. Simple lists, gentle color, and a focused workspace help make the next step feel clear.',
    discipline: 'Product design · Interaction',
  },
  {
    id: 'orbit',
    views: ['work'],
    shape: 'tall',
    title: 'Orbit',
    kind: 'Concept',
    summary: 'A music player concept that puts the artwork first.',
    detail:
      'An independent music-app concept exploring a more expressive listening experience. Dark surfaces, bold artwork, and a focused library put the music first.',
    discipline: 'Product design · Visual exploration',
  },
  {
    id: 'kamigotchi',
    views: ['visual-craft'],
    shape: 'landscape',
    title: 'Kamigotchi',
    kind: 'Artwork',
    summary: kamigotchiDescription,
    detail: kamigotchiDescription,
    overview:
      'Working alongside the existing pixel-art direction, I focused on graphic design and animation—creating visuals that help communicate the game’s identity across digital platforms and community-facing spaces.',
    discipline: 'Graphic design',
    tools: ['Figma', 'Midjourney', 'Adobe After Effects', 'Adobe Illustrator', 'Adobe Photoshop'],
    artwork: [
      {
        image: championsArtwork,
        alt: 'Kamigotchi World Community Champions poster with a pixel-art trophy and colorful characters against a yellow sunburst.',
      },
      {
        image: kamigotchiIntroduction,
        alt: 'Introducing Kamigotchi World banner with six colorful pixel-art characters in a forest.',
      },
      {
        image: kamigotchiOnboarding,
        alt: 'Two Kamigotchi onboarding banners titled How to Play and Welcome to Yominet.',
      },
      {
        image: kamigotchiItems,
        alt: 'Item of the Week graphics featuring an egg and a red heart crystal.',
      },
      {
        image: kamigotchiEvents,
        alt: 'Promotional cards for Kamigotchi Weekly Session 11 and How Kamigotchi Save the World.',
      },
      {
        image: kamigotchiZones,
        alt: 'New Zones Available banner showing four illustrated game locations.',
      },
      {
        image: kamigotchiZoneVariants,
        alt: 'Purple and orange versions of a New Zones Available graphic, each showing three zone previews.',
      },
      {
        image: kamigotchiStickers,
        alt: 'Three Kamigotchi character stickers with yellow outlines.',
      },
    ],
  },
  {
    id: 'eth-salvador',
    views: ['visual-craft'],
    shape: 'landscape',
    title: 'ETH Salvador',
    kind: 'Brand identity',
    summary: ethSalvadorDescription,
    detail: ethSalvadorDescription,
    discipline: 'Event branding',
    tools: ['Midjourney', 'Adobe Photoshop', 'Adobe Illustrator', 'Adobe After Effects'],
    artwork: [
      {
        image: ethSalvadorArtwork,
        alt: 'ETH Salvador 2024 poster with an Ethereum emblem above a volcanic landscape at sunset.',
      },
    ],
  },
  {
    id: 'invisible-garden',
    views: ['visual-craft'],
    shape: 'landscape',
    title: 'Invisible Garden',
    kind: 'Visual identity',
    summary: invisibleGardenDescription,
    detail: invisibleGardenDescription,
    discipline: 'Event branding · Web design',
    tools: [
      'Webflow',
      'Figma',
      'Adobe Illustrator',
      'Adobe Photoshop',
      'Adobe After Effects',
      'Midjourney',
    ],
    artwork: [
      {
        image: invisibleGardenArtwork,
        alt: 'The green and purple Invisible Garden wordmark over an illustrated landscape with trees and an obelisk.',
      },
    ],
  },
  {
    id: 'illustrations',
    views: ['visual-craft'],
    shape: 'landscape',
    title: 'Illustrations',
    kind: 'Collection',
    summary: illustrationDescription,
    detail: illustrationDescription,
    discipline: 'Illustration',
    tools: ['Procreate', 'Adobe Illustrator', 'Adobe Photoshop'],
    artwork: [
      {
        image: illustrationsCover,
        alt: 'Two illustrated hands reach toward a glowing orange Ethereum symbol in a colorful rocky landscape.',
      },
    ],
  },
  {
    id: 'collective-2077',
    views: ['visual-craft'],
    shape: 'landscape',
    title: 'Collective 2077',
    kind: 'Visual identity',
    summary: collective2077Description,
    detail: 'Visual Identity & Graphic Design for Collective 2077',
    overview: collective2077Description,
    discipline: 'Visual identity · Graphic design',
    artwork: [
      {
        image: collective2077Cover,
        alt: 'Glowing cyan cubes hover over a wireframe grid on a dark background with the 2077 Research logo.',
      },
      {
        image: collective2077BrandGraphics,
        alt: 'Four 2077 Research graphics featuring teal isometric cubes, Ethereum motifs, and a white emblem.',
      },
      {
        image: collective2077Editorial,
        alt: 'Four dark editorial illustrations featuring white emblems, glowing blue rings, and a chain.',
      },
      {
        image: collective2077Roadmaps,
        alt: 'Four Alpha Roadmap graphics for the EVM Query Language, including milestone timelines.',
      },
      {
        image: collective2077BridgeGraphics,
        alt: 'Four research graphics on bridge hacks, canonical rollup bridges, third-party bridges, and liquidity bridges.',
      },
      {
        image: collective2077EthereumBanners,
        alt: 'Two Ethereum banners about restaking and leadership in blockchains.',
      },
    ],
  },
];
const visualProjects = projects.filter((project) => project.views.includes('visual-craft'));
const workProjects = projects.filter((project) => !project.views.includes('visual-craft'));
const visualProjectImageOptions = {
  class: 'visual-project-artwork',
  widths: [400, 800, 1200, 1600],
  sizes: '(max-width: 740px) calc(100vw - 32px), (max-width: 1647px) 65vw, 1056px',
  quality: 'high' as const,
};
const filters = [
  { id: 'work', label: 'Selected work' },
  { id: 'visual-craft', label: 'Visual craft' },
];
const columns = [
  [projects[5], projects[7], projects[9], projects[0], projects[2], projects[4]],
  [projects[6], projects[8], projects[1], projects[3]],
];
---

<BaseLayout
  title="Jose Basanta — Product Designer"
  description="A space for things I design, build, and explore. Product design, concepts, and small experiments by Jose Basanta."
>
  <a class="skip-link" href="#gallery">
    Skip to projects
  </a>
  <main class="studio-shell">
    <aside class="profile-column" aria-label="About Jose">
      <div>
        <h1>Jose Basanta</h1>
        <p class="profile-bio">
          I'm a product designer. This is a space for the interfaces, ideas, and experiments I
          design and build.
        </p>
        <div class="profile-actions">
          <button type="button" class="about-trigger" data-open="about-dialog">
            About me
            {profilePhoto && (
              <span class="about-portrait" aria-hidden="true">
                <Image src={profilePhoto} alt="" width={224} height={224} fit="cover" />
              </span>
            )}
          </button>
          <button
            type="button"
            class="contact-button"
            aria-label="Get in touch (copy email address)"
            aria-describedby="contact-email"
          >
            <span class="contact-message" aria-hidden="true">
              Get in touch
              <span class="contact-icon">
                <i class="ph ph-envelope-simple"></i>
                <i class="ph ph-copy"></i>
              </span>
            </span>
            <span class="contact-confirmation" aria-hidden="true">
              Email copied <i class="ph ph-check"></i>
            </span>
            <span class="contact-preview" id="contact-email">{contactEmail}</span>
          </button>
          <p class="contact-fallback" hidden>
            <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
          </p>
          <span class="sr-only" id="contact-status" role="status"></span>
        </div>
      </div>
      <nav class="profile-links" aria-label="More from Jose">
        <a href="https://x.com/joseebasanta" target="_blank" rel="noopener">
          X / Twitter <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
        </a>
        <a
          href="https://www.linkedin.com/in/jose-basanta-544052211/"
          target="_blank"
          rel="noopener"
        >
          LinkedIn <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
        </a>
        <a href="https://github.com/joseebasanta" target="_blank" rel="noopener">
          GitHub <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
        </a>
      </nav>
    </aside>

    <section class="work-section" id="gallery" aria-label="Projects and experiments" tabindex="-1">
      <nav class="gallery-nav" aria-label="Filter projects">
        {filters.map((filter, index) => (
          <a
            href={`#${filter.id}`}
            data-view={filter.id}
            aria-current={index === 0 ? 'true' : undefined}
          >
            {filter.label}
          </a>
        ))}
      </nav>
      <div class="project-grid">
        {columns.map((column) => (
          <div class="project-stack">
            {column.map((project) => (
              <button
                type="button"
                class:list={['project-card', project.shape]}
                data-project={project.id}
                data-gallery-views={project.views.join(' ')}
                hidden={!project.views.includes('work')}
                aria-label={`Explore ${project.title} — ${project.kind}`}
                aria-describedby={`summary-${project.id}`}
                aria-haspopup="dialog"
              >
                {project.artwork?.[0] && (
                  <Image
                    class="project-image"
                    src={project.artwork[0].image}
                    alt=""
                    widths={[360, 720, 1080, 1440]}
                    sizes="(max-width: 480px) calc(100vw - 32px), (max-width: 740px) 50vw, 37vw"
                    quality="high"
                  />
                )}
                <span class="project-caption">
                  <span class="project-name">{project.title}</span>
                  <span class="project-summary">
                    <span class="project-summary-track">
                      <span id={`summary-${project.id}`}>{project.summary}</span>
                      <span aria-hidden="true">{project.summary}</span>
                      <span aria-hidden="true">{project.summary}</span>
                    </span>
                  </span>
                </span>
              </button>
            ))}
          </div>
        ))}
      </div>
    </section>
  </main>
  {visualProjects.map((p) => (
    <dialog
      class="visual-project-dialog"
      id={`project-${p.id}`}
      aria-labelledby={`title-${p.id}`}
    >
      <div class="visual-project-panel">
        <header class="visual-project-header">
          <button
            type="button"
            class="close-button visual-project-close"
            data-close
            aria-label="Close project"
            autofocus
          >
            <i class="ph ph-x" aria-hidden="true"></i>
          </button>
          <p class="eyebrow">{p.discipline}</p>
          <h2 id={`title-${p.id}`}>{p.title}</h2>
          {p.tools && p.tools.length > 0 && (
            <ul class="visual-project-tools" role="list" aria-label="Tools used">
              {p.tools.map((tool) => (
                <li>
                  <img
                    src={`${import.meta.env.BASE_URL}images/tools/${toolLogos[tool]}`}
                    alt=""
                    width="16"
                    height="16"
                  />
                  <span>{tool}</span>
                </li>
              ))}
            </ul>
          )}
        </header>
        <section class="visual-project-scroll" aria-label="Project details" tabindex="0">
          {p.artwork?.[0] && (
            <Image {...visualProjectImageOptions} src={p.artwork[0].image} alt={p.artwork[0].alt} />
          )}
          <p class:list={['visual-project-description', { 'visual-project-lead': p.overview }]}>
            {p.detail}
          </p>
          {p.overview && (
            <section class="visual-project-overview" aria-labelledby={`overview-${p.id}`}>
              <h3 class="eyebrow" id={`overview-${p.id}`}>Overview</h3>
              <p>{p.overview}</p>
            </section>
          )}
          {p.artwork?.slice(1).map(({ image, alt }) => (
            <Image {...visualProjectImageOptions} src={image} alt={alt} />
          ))}
        </section>
      </div>
    </dialog>
  ))}
  {workProjects.map((p) => (
    <dialog
      class="studio-dialog project-dialog"
      id={`project-${p.id}`}
      aria-labelledby={`title-${p.id}`}
    >
      <button class="close-button" data-close aria-label="Close project">
        <i class="ph ph-x" aria-hidden="true"></i>
      </button>
      {p.artwork?.[0] ? (
        <Image
          class="dialog-artwork"
          src={p.artwork[0].image}
          alt={p.artwork[0].alt}
          widths={[400, 800, 1600]}
          sizes="(max-width: 836px) calc(100vw - 36px), 800px"
          quality="high"
        />
      ) : (
        <div class="dialog-cover" aria-hidden="true"></div>
      )}
      <div class="dialog-content">
        <span class="eyebrow">{p.discipline}</span>
        <h2 id={`title-${p.id}`}>
          {p.title}
          <span class="project-tag">{p.kind}</span>
        </h2>
        <p>{p.detail}</p>
        {p.id === 'variable-type' && (
          <div class="type-demo">
            <div
              class="type-specimen"
              contenteditable="plaintext-only"
              role="textbox"
              aria-label="Type something to try the variable font"
              spellcheck="false"
            >
              Play a little.
            </div>
            <label for="type-weight">
              Font weight <output id="weight-value">500</output>
            </label>
            <input id="type-weight" type="range" min="100" max="900" step="1" value="500" />
          </div>
        )}
        <p class="concept-note">An independent design exploration.</p>
      </div>
    </dialog>
  ))}
  <dialog class="studio-dialog small-dialog" id="about-dialog" aria-labelledby="about-title">
    <button class="close-button" data-close aria-label="Close about">
      <i class="ph ph-x" aria-hidden="true"></i>
    </button>
    <div class="dialog-content">
      <span class="eyebrow">A little introduction</span>
      <h2 id="about-title">Hi, I'm Jose.</h2>
      <p>
        I'm a product designer. This is my corner of the internet for sharing the things I design,
        build, and explore.
      </p>
      <p>
        A mix of product concepts, visual experiments, and small ideas that turn into something.
      </p>
      <button class="primary-button" data-close>
        Explore the work <i class="ph ph-arrow-right" aria-hidden="true"></i>
      </button>
    </div>
  </dialog>
</BaseLayout>
<script>
  import { trackPortfolioEvent } from '@/analytics/mixpanel';

  const previewButtons = document.querySelectorAll<HTMLButtonElement>(
    '.about-trigger:has(.about-portrait), .contact-button',
  );
  previewButtons.forEach((button) => {
    button.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'mouse') return;
      const bounds = button.getBoundingClientRect();
      const position = (event.clientX - bounds.left) / bounds.width;
      const offset = Math.max(-1, Math.min(1, position * 2 - 1));
      button.style.setProperty('--preview-offset', `${offset * 12}px`);
      button.style.setProperty('--preview-tilt', `${offset * 7}deg`);
    });
  });

  const contactButton = document.querySelector<HTMLButtonElement>('.contact-button');
  const contactEmail = document.getElementById('contact-email');
  const contactStatus = document.getElementById('contact-status');
  const contactFallback = document.querySelector<HTMLElement>('.contact-fallback');
  let contactReset: number;

  if (contactButton && contactEmail && contactStatus && contactFallback) {
    contactButton.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(contactEmail.textContent.trim());
      } catch {
        window.clearTimeout(contactReset);
        contactButton.removeAttribute('data-copied');
        contactFallback.hidden = false;
        contactStatus.textContent = 'Could not copy the email address. Use the email link below.';
        return;
      }

      window.clearTimeout(contactReset);
      contactFallback.hidden = true;
      contactButton.setAttribute('data-copied', '');
      contactStatus.textContent = 'Email copied';
      contactReset = window.setTimeout(() => {
        contactButton.removeAttribute('data-copied');
        contactStatus.textContent = '';
      }, 2500);
    });
  }

  const dialogTriggers = new WeakMap<HTMLDialogElement, HTMLButtonElement>();

  const openDialog = (id: string, trigger?: HTMLButtonElement) => {
    const dialog = document.getElementById(id);
    if (!(dialog instanceof HTMLDialogElement) || dialog.open) return;
    document.querySelectorAll<HTMLDialogElement>('dialog[open]').forEach((item) => item.close());
    dialog.removeAttribute('data-closing');
    if (trigger && dialog.classList.contains('visual-project-dialog')) {
      dialogTriggers.set(dialog, trigger);
    }
    dialog.showModal();
    document.documentElement.classList.add('dialog-open');
    const scrollArea = dialog.querySelector('.visual-project-scroll');
    if (scrollArea) scrollArea.scrollTop = 0;
  };

  const closeDialog = async (dialog: HTMLDialogElement) => {
    if (!dialog.open || dialog.hasAttribute('data-closing')) return;

    const panel = dialog.querySelector('.visual-project-panel');
    if (panel) {
      dialog.setAttribute('data-closing', '');
      await Promise.allSettled(panel.getAnimations().map((animation) => animation.finished));
      if (!dialog.hasAttribute('data-closing')) return;
    }

    dialog.close();
  };
  document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((button) => {
    button.addEventListener('click', () => openDialog(button.dataset.open!));
  });
  document.querySelectorAll<HTMLButtonElement>('[data-project]').forEach((button) => {
    button.addEventListener('click', () => {
      const project = button.dataset.project;
      if (!project) return;
      openDialog(`project-${project}`, button);
      trackPortfolioEvent('Project Opened', { project_id: project });
    });
  });
  document.querySelectorAll<HTMLDialogElement>('dialog').forEach((dialog) => {
    dialog
      .querySelectorAll('[data-close]')
      .forEach((button) => button.addEventListener('click', () => void closeDialog(dialog)));
    if (dialog.classList.contains('visual-project-dialog')) {
      dialog.addEventListener('cancel', (event) => {
        event.preventDefault();
        void closeDialog(dialog);
      });
    }
    dialog.addEventListener('click', (event) => {
      if (event.target !== dialog) return;
      const panel = dialog.querySelector('.visual-project-panel') ?? dialog;
      const box = panel.getBoundingClientRect();
      if (
        event.clientX < box.left ||
        event.clientX > box.right ||
        event.clientY < box.top ||
        event.clientY > box.bottom
      ) {
        void closeDialog(dialog);
      }
    });
    dialog.addEventListener('close', () => {
      if (dialog.open) return;
      dialog.removeAttribute('data-closing');
      if (document.querySelector('dialog[open]')) return;
      document.documentElement.classList.remove('dialog-open');
      dialogTriggers.get(dialog)?.focus({ preventScroll: true });
    });
  });
  const filters = [...document.querySelectorAll<HTMLAnchorElement>('[data-view]')];
  const cards = document.querySelectorAll<HTMLButtonElement>('[data-gallery-views]');

  const applyFilter = () => {
    const hash = location.hash.slice(1);
    const requested = hash === 'playground' ? 'visual-craft' : hash;
    const active = filters.some((link) => link.dataset.view === requested) ? requested : 'work';

    cards.forEach((card) => {
      card.hidden = !card.dataset.galleryViews?.split(' ').includes(active);
    });
    filters.forEach((link) => {
      if (link.dataset.view === active) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    });
  };

  window.addEventListener('hashchange', applyFilter);
  applyFilter();

  const summaryPixelsPerSecond = 18;
  const summaryObserver = new ResizeObserver((entries) => {
    for (const { target, contentRect } of entries) {
      if (!(target instanceof HTMLElement) || contentRect.width === 0) continue;

      // Each loop moves by one of the three equal copies of the summary.
      const distance = contentRect.width / 3;
      target.style.setProperty(
        '--project-summary-duration',
        `${distance / summaryPixelsPerSecond}s`,
      );
    }
  });
  document
    .querySelectorAll('.project-summary-track')
    .forEach((track) => summaryObserver.observe(track));

  const slider = document.querySelector<HTMLInputElement>('#type-weight');
  slider?.addEventListener('input', () => {
    const specimen = document.querySelector<HTMLElement>('.type-specimen');
    if (specimen) specimen.style.fontWeight = slider.value;
    const output = document.querySelector<HTMLOutputElement>('#weight-value');
    if (output) output.value = slider.value;
  });
</script>
