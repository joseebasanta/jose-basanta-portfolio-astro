---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AboutContent from '@/components/portfolio/AboutContent.astro';
import Header from '@/components/sections/Header.astro';
import Footer from '@/components/sections/Footer.astro';
import ScrollProgress from '@/components/motion/ScrollProgress.astro';
import Container from '@/components/ui/Container.astro';
---

<BaseLayout
  title="About"
  description="Jose Basanta is a freelance UI/UX and product designer specializing in research-backed interfaces and design systems."
>
  <ScrollProgress />
  <Header />
  <main class="py-8 sm:py-12">
    <Container class="max-w-[1088px]">
      <AboutContent standalone />
    </Container>
  </main>
  <Footer />
</BaseLayout>
