<div class="pointer-events-none fixed inset-x-0 top-0 z-50 h-0.5 bg-transparent">
  <div
    id="scroll-progress-bar"
    class="h-full origin-left bg-accent"
    style="transform: scaleX(0)"
  ></div>
</div>

<script>
  import { scroll } from 'motion';

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const bar = document.getElementById('scroll-progress-bar');

  // A scroll-linked indicator is informational, not decorative motion —
  // but we still skip the continuous scroll listener under reduced motion
  // and hide the bar rather than leave a frozen, inaccurate sliver.
  if (bar) {
    if (prefersReducedMotion) {
      bar.parentElement?.classList.add('hidden');
    } else {
      scroll((progress) => {
        bar.style.transform = `scaleX(${progress})`;
      });
    }
  }
</script>
